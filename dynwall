def preview_weather_image(image, scenario):
    """Explicitly illustrative still particles for the offline settings thumbnail."""
    if scenario not in ("rain", "snow", "storm"):
        return image
    overlay = Image.new("RGBA", image.size)
    draw = ImageDraw.Draw(overlay)
    rng = random.Random(8291)
    width, height = image.size
    for _ in range(180 if scenario == "snow" else 260):
        x, y = rng.randrange(width), rng.randrange(height)
        if scenario == "snow":
            radius = max(1, round(height / 360 * rng.uniform(.5, 1.7)))
            draw.ellipse((x-radius, y-radius, x+radius, y+radius), fill=(233,241,247,170))
        else:
            length = max(3, round(height / 45))
            draw.line((x,y,x+length//3,y+length),fill=(188,215,235,95),width=1)
    if scenario == "storm":
        draw.line([(width*.72,height*.12),(width*.69,height*.26),(width*.73,height*.25),(width*.68,height*.43)],fill=(235,229,255,225),width=max(1,height//180))
    return Image.alpha_composite(image.convert("RGBA"), overlay).convert("RGB")


