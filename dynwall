def get_spec(weather: str, cfg: dict, snapshot=None) -> dict:
    now = datetime.now()
    background = background_spec(now, cfg, weather)
    if background is not None:
        return background
    themed = theme_spec(now, cfg, snapshot)
    if themed is not None:
        return themed
    template = cfg.get("prompt") or get_default_prompt()
    signature = f"{template}\n{RENDERER_CONTRACT}\n{cfg['width']}x{cfg['height']}"
    key = f"{now:%Y-%m-%d-%H}|{weather}|{cfg['provider']}|{cfg['model']}|{hashlib.sha256(signature.encode()).hexdigest()}"

    if SPEC_CACHE.exists():
        try:
            cached = json.loads(SPEC_CACHE.read_text())
            if cached.get("key") == key:
                return cached["spec"]
        except Exception:
            pass

    spec = llm_spec(now, weather, cfg) or fallback_spec(now, weather)
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    SPEC_CACHE.write_text(json.dumps({"key": key, "spec": spec}))
    return spec


def build_art_prompt(now: datetime, weather: str, cfg: dict) -> str:
    template = cfg.get("prompt") or get_default_prompt()
    context = {"time": f"{now:%Y-%m-%d %A %H:%M}", "weather": weather,
               "width": str(cfg["width"]), "height": str(cfg["height"])}
    for name, value in context.items():
        template = template.replace("{" + name + "}", value)
    return (f"{template}\n\n{RENDERER_CONTRACT}\n\n"
            f"Local time: {context['time']}. Local month: {now:%B}.\n"
            f"Observed weather: {weather}. Canvas: {cfg['width']}x{cfg['height']}.\n"
            "This canvas can span monitors: avoid putting the focal disc exactly at x=0.5.")


def llm_spec(now: datetime, weather: str, cfg: dict):
    if not cfg.get("allow_network", True):
        return None
    provider = cfg.get("provider", "openai")
    if provider == "none" or provider not in PROVIDERS:
        return None
    key = os.environ.get(PROVIDERS[provider]["env_key"], "").strip() or cfg.get("api_key")
    if not key:
        return None
    prompt = build_art_prompt(now, weather, cfg)
    headers = {"Authorization": f"Bearer {key}"}
    if provider == "openrouter":
        headers["HTTP-Referer"] = "dynwall"
    try:
        import requests
        r = requests.post(
            PROVIDERS[provider]["url"],
            headers=headers,
            json={
                "model": cfg.get("model") or PROVIDERS[provider]["default_model"],
                "messages": [{"role": "user", "content": prompt}],
                "response_format": {"type": "json_object"},
                "max_completion_tokens": 900,
            },
            timeout=30,
        )
        r.raise_for_status()
        spec = json.loads(r.json()["choices"][0]["message"]["content"])
        # minimal validation
        assert isinstance(spec["gradient"], list) and len(spec["gradient"]) >= 2
        return spec
    except Exception as e:
        print(f"LLM spec failed ({e}); using fallback", file=sys.stderr)
        return None


def fallback_spec(now: datetime, weather: str, style="hills"):
    """A smooth local-clock composition; artistic, not a solar ephemeris."""
    hour = now.hour + now.minute / 60 + now.second / 3600
    night = ["#070f20", "#14243c", "#2a3852", "#4c546b", "#777284"]
    dawn = ["#253650", "#686078", "#ae8591", "#dfb49e", "#f0dbb7"]
    day = ["#234961", "#4d8198", "#87aeb6", "#bacdc7", "#e7ddc4"]
    dusk = ["#293655", "#644f70", "#ac7787", "#dfa68a", "#f0d5b2"]
    if style == "alpine":
        night = ["#060e1a", "#142337", "#2a3a50", "#4f6174", "#8c9ea6"]
        day = ["#204b65", "#4d8097", "#83afbd", "#bdcfd0", "#e8e3d1"]
        dawn = ["#343e62", "#7e7799", "#bf9da6", "#e7c7b6", "#f4e3ce"]
        dusk = ["#283750", "#6e6781", "#b3909a", "#ddb9a2", "#f1dbbd"]
    elif style == "dunes":
        night = ["#120e1b", "#302438", "#534054", "#806170", "#ad8b83"]
        day = ["#386274", "#72939a", "#adbbaf", "#d8c9a9", "#f0d6a7"]
        dawn = ["#443653", "#89627b", "#c38f91", "#e5b69e", "#f7dbb5"]
        dusk = ["#342c49", "#71516c", "#b4797c", "#db9e84", "#edc49d"]
    elif style == "ocean":
        night = ["#050f1b", "#102b3a", "#224852", "#42666c", "#74918d"]
        day = ["#1e506b", "#40839a", "#7fb2bc", "#bbd4cf", "#e5e2c9"]
        dawn = ["#303e59", "#726f88", "#b49aab", "#ddc4b9", "#f4e2cc"]
        dusk = ["#28364e", "#605e79", "#9c8293", "#cfa99d", "#edcbb0"]
    anchors = [(0, night), (5, night), (7, dawn), (11, day),
               (15, day), (18, dusk), (20.5, night), (24, night)]
    for (start, a), (end, b) in zip(anchors, anchors[1:]):
        if start <= hour <= end:
            fraction = (hour - start) / (end - start)
            fraction = fraction * fraction * (3 - 2 * fraction)
            stops = [tuple(round(x + (y-x)*fraction) for x,y in zip(hex_rgb(c), hex_rgb(d)))
                     for c,d in zip(a,b)]
            break
    autumn = style == "hills" and now.month in (9, 10, 11)
    # A little seasonal color near the horizon; keep the upper sky open and quiet.
    if autumn:
        stops = [tuple(round(c*(1-i*.025) + warm*i*.025) for c,warm in zip(color, (215,150,102)))
                 for i,color in enumerate(stops)]
    description = weather.lower()
    wet = any(word in description for word in ("rain", "cloud", "overcast", "fog", "snow"))
    if wet:
        stops = [tuple(round(c*.78 + sum(color)/3*.22) for c in color) for color in stops]
    dark = hour < 6 or hour >= 20
    twilight = 6 <= hour <= 8 or 16 <= hour < 20
    return {
        "title": {"alpine": "Alpine Stillness", "dunes": "Amber Dunes", "ocean": "Tidal Light",
                  "none": "Open Sky"}.get(style, ("Copper" if autumn else "Luminous") + (" night" if dark else " horizon")),
        "gradient": ["#%02x%02x%02x" % color for color in stops],
        "gradient_positions": [0, .32, .64, .84, 1],
        "accent": "#d9a566" if autumn else "#b7c9ba",
        "glow": {"color": "#b0c4e4" if dark else "#ffe0b4",
                 "x": .73, "y": .3 if dark else .48 if twilight else .32,
                 "size": 1.1, "intensity": .22 if dark else .5, "pulse": .025},
        "celestial": {"type": "moon" if dark else "sun", "x": .73,
                      "y": .3 if dark else .48 if twilight else .32,
                      "size": .032, "drift": .004},
        "landscape": {"style": style, "height": .28 if style == "alpine" else .2,
                      "mist": .65 if wet else .45},
        "stars": 420 if dark else 0,
        "mesh": {"style": "none", "density": 18, "opacity": .025},
        "grain": .009, "vignette": .22, "mood": "hushed" if dark else "luminous",
    }


# ── helpers ──────────────────────────────────────────────────────────────────

def hex_rgb(s, fallback=(136, 136, 136)):
    """Parse '#rrggbb' (with/without '#') to an (r, g, b) tuple.

    LLM specs are untrusted: malformed or short strings fall back to gray
    instead of crashing the render.
    """
    try:
        s = str(s).lstrip("#")[:6]
        if len(s) < 6:
            raise ValueError(f"short color {s!r}")
        return tuple(int(s[i:i + 2], 16) for i in (0, 2, 4))
    except (TypeError, ValueError):
        return fallback


def num(v, default):
    """Coerce LLM output to a float; handles '0.06-0.12' style ranges."""
    try:
        return float(v)
    except (TypeError, ValueError):
        import re
        vals = [float(x) for x in re.findall(r"\d+\.?\d*", str(v))]
        return sum(vals) / len(vals) if vals else default


def clamp(v, lo, hi):
    return max(lo, min(hi, v))


# ── layer building (static parts, computed once) ────────────────────────────

def build_scene(spec, mesh_enabled: bool = True, landscape_enabled: bool = True):
    """Returns a dict of pre-built layers + animation params."""
    stops = [hex_rgb(c) for c in spec["gradient"][:5]]
    if len(stops) < 2:
        stops = [(10, 12, 28), (28, 26, 60)]
    accent = hex_rgb(spec.get("accent", "#888888"))
    glow = spec.get("glow") if isinstance(spec.get("glow"), dict) else None
    celestial = spec.get("celestial") if isinstance(spec.get("celestial"), dict) else None
    stars_n = int(clamp(num(spec.get("stars"), 0), 0, 600))
    mesh_cfg = spec.get("mesh") if isinstance(spec.get("mesh"), dict) else {}
    mesh_style = str(mesh_cfg.get("style", "lowpoly")) if mesh_enabled else "none"
    mesh_op = clamp(num(mesh_cfg.get("opacity", spec.get("mesh_opacity")), 0.08), 0.02, 0.16)
    density = int(clamp(num(mesh_cfg.get("density", spec.get("mesh_density")), 18), 10, 28))
    grain = clamp(num(spec.get("grain"), 0.025), 0.0, 0.06)
    vig_strength = clamp(num(spec.get("vignette"), 0.7), 0.0, 1.0)

    # gradient (built as 1×H strip, stretched — fast)
    positions = spec.get("gradient_positions")
    if not (isinstance(positions, list) and len(positions) == len(stops)):
        positions = [i / (len(stops) - 1) for i in range(len(stops))]
    positions = [clamp(num(p, i / (len(stops) - 1)), 0.0, 1.0)
                 for i, p in enumerate(positions)]
    strip = Image.new("RGB", (1, H))
    spx = strip.load()
    for y in range(H):
        t = y / max(1, H - 1)
        i = 0
        while i < len(positions) - 2 and t > positions[i + 1]:
            i += 1
        p0, p1 = positions[i], positions[i + 1]
        f = 0.0 if p1 <= p0 else clamp((t - p0) / (p1 - p0), 0.0, 1.0)
        f = f * f * (3 - 2 * f)
        spx[0, y] = tuple(int(stops[i][k] + (stops[i + 1][k] - stops[i][k]) * f) for k in range(3))
    base = strip.resize((W, H))

    # glow: keep the L-mask separate so it can pulse per frame
    glow_mask = None
    glow_c = None
    glow_pulse = 0.0
    if glow:
        gx_f = clamp(num(glow.get("x"), 0.68), 0.05, 0.95)
        gy_f = clamp(num(glow.get("y"), 0.30), 0.0, 1.0)
        gsize = clamp(num(glow.get("size"), 0.8), 0.2, 1.2)
        gint = clamp(num(glow.get("intensity"), 0.8), 0.0, 1.0)
        glow_pulse = clamp(num(glow.get("pulse"), 0.15), 0.0, 0.3)
        glow_c = hex_rgb(glow.get("color", "#ffffff"))
        glow_x, glow_y = W * gx_f, H * gy_f
        glow_mask = Image.new("L", (W, H), 0)
        d = ImageDraw.Draw(glow_mask)
        r = int(H * gsize)
        for rr in range(r, 0, -6):
            a = int(110 * gint * (1 - rr / r) ** 2)
            d.ellipse([glow_x - rr, glow_y - rr, glow_x + rr, glow_y + rr], fill=a)
        glow_mask = glow_mask.filter(ImageFilter.GaussianBlur(60))
    else:
        glow_x, glow_y = W * 0.68, H * 0.30

    # celestial: rendered at origin into a tile so it can drift per frame
    cel_tile = None
    cel_cfg = None
    if celestial:
        ctype = str(celestial.get("type", "moon"))
        cr = H * clamp(num(celestial.get("size"), 0.07), 0.03, 0.15)
        cel_cfg = {
            "x": clamp(num(celestial.get("x"), 0.3), 0.05, 0.95),
            "y": clamp(num(celestial.get("y"), 0.25), 0.0, 1.0),
            "r": cr,
            "drift": clamp(num(celestial.get("drift"), 0.02), 0.0, 0.05),
        }
        pad = int(cr * 2.5) * 2
        cel_tile = Image.new("RGBA", (pad, pad), (0, 0, 0, 0))
        d = ImageDraw.Draw(cel_tile)
        ccx = ccy = pad // 2
        halo_c = (255, 244, 214) if ctype == "sun" else (210, 218, 240)
        for rr in range(int(cr * 2.2), int(cr), -3):
            a = int(60 * (1 - (rr - cr) / (cr * 1.2)))
            d.ellipse([ccx - rr, ccy - rr, ccx + rr, ccy + rr], fill=(*halo_c, a))
        d.ellipse([ccx - cr, ccy - cr, ccx + cr, ccy + cr], fill=(*halo_c, 235))
        if ctype == "moon":  # simple crater shading
            rng_c = random.Random(7)
            for _ in range(7):
                ang = rng_c.uniform(0, 6.283)
                dist = rng_c.uniform(0, cr * 0.7)
                mx, my = ccx + dist * math.cos(ang), ccy + dist * math.sin(ang)
                mr = rng_c.uniform(cr * 0.06, cr * 0.16)
                d.ellipse([mx - mr, my - mr, mx + mr, my + mr], fill=(160, 170, 200, 60))
        cel_tile = cel_tile.filter(ImageFilter.GaussianBlur(1.5))

    # stars: stored as data (twinkle computed per frame)
    stars = []
    if stars_n > 0:
        rng_s = random.Random(42)
        for _ in range(stars_n):
            stars.append({
                "x": rng_s.uniform(0, W),
                "y": rng_s.uniform(0, H * 0.9),
                "r": rng_s.choice([1, 1, 1, 2]),
                "b": rng_s.randint(90, 255),
                "phase": rng_s.uniform(0, 6.283),
                "speed": rng_s.uniform(0.5, 2.0),
            })

    # mesh overlay (static)
    rng = random.Random(int(time.time() // 1800))  # stable per half-hour
    mesh = Image.new("RGBA", (W, H), (0, 0, 0, 0))
    md = ImageDraw.Draw(mesh)
    if mesh_style == "lowpoly":
        cols, rows = density, max(3, density * H // W)
        gx, gy = W / cols, H / rows
        grid = []
        for r in range(rows + 1):
            row = []
            for c in range(cols + 1):
                jx = rng.uniform(-0.45, 0.45) * gx if 0 < c < cols else 0
                jy = rng.uniform(-0.45, 0.45) * gy if 0 < r < rows else 0
                row.append((c * gx + jx, r * gy + jy))
            grid.append(row)
        for r in range(rows):
            for c in range(cols):
                p00, p10 = grid[r][c], grid[r][c + 1]
                p01, p11 = grid[r + 1][c], grid[r + 1][c + 1]
                for tri in ((p00, p10, p11), (p00, p11, p01)):
                    cx = sum(p[0] for p in tri) / 3
                    cy = sum(p[1] for p in tri) / 3
                    lum = 1 - min(1.0, math.hypot(cx - glow_x, cy - glow_y) / (W * 0.45))
                    col = accent if rng.random() < 0.18 else (255, 255, 255)
                    alpha = int(255 * mesh_op * (0.25 + lum * 1.1) * rng.uniform(0.6, 1.3))
                    md.polygon(tri, fill=(*col, max(2, min(70, alpha))))
        mesh = mesh.filter(ImageFilter.GaussianBlur(0.5))
    elif mesh_style == "lines":
        step = max(14, H // density)
        for i, y in enumerate(range(0, H + step, step)):
            lum = 1 - min(1.0, abs(y - glow_y) / (H * 0.8))
            alpha = int(255 * mesh_op * (0.3 + lum))
            col = accent if i % 4 == 0 else (255, 255, 255)
            pts = [(x, y + 6 * math.sin(x / W * 6.28 * 2 + i)) for x in range(0, W + 40, 40)]
            md.line(pts, fill=(*col, max(2, min(80, alpha))), width=2)

    # vignette (static)
    vig = None
    if vig_strength > 0:
        # Same gentle attenuation as GLSL: strength darkens the edges, while
        # the center remains fully lit. Build a bounded mask, then upscale.
        vw, vh = min(W, 512), min(H, 256)
        pixels = bytearray(
            round(255 * (1-vig_strength*min(1, (((x+.5)/vw-.5)**2 + ((y+.5)/vh-.5)**2)*1.3)*.6))
            for y in range(vh) for x in range(vw)
        )
        vig = Image.frombytes("L", (vw, vh), bytes(pixels)).resize((W, H), Image.Resampling.BILINEAR)

    return {
        "base": base, "glow_mask": glow_mask, "glow_c": glow_c,
        "glow_pulse": glow_pulse, "cel_tile": cel_tile, "cel_cfg": cel_cfg,
        "stars": stars, "mesh": mesh if mesh_style != "none" else None,
        "grain": grain, "vig": vig,
        "landscape": build_landscape(spec, stops) if landscape_enabled else None,
    }


def build_landscape(spec, stops):
    """Static scene counterpart to the GPU silhouettes and materials."""
    cfg = spec.get("landscape") if isinstance(spec.get("landscape"), dict) else {}
    if cfg.get("style") == "none":
        return None
    height = clamp(num(cfg.get("height"), .2), .1, .3)
    mist = clamp(num(cfg.get("mist"), .5), 0, 1)
    daylight = 0 if num(spec.get("stars"), 0) > 0 else 1
    shadow = [stops[0][i]*.22 + stops[1][i]*.15 for i in range(3)]
    horizon = [v*(.38 + .62*daylight) for v in stops[-1]]
    layer = Image.new("RGBA", (W, H), (0, 0, 0, 0))
    draw = ImageDraw.Draw(layer)
    style = cfg.get("style", "hills")
    if style == "ocean":
        waterline = 1-height
        light_x = num(spec.get("celestial", {}).get("x"), .73)*W
        for py in range(round(waterline*H), H):
            depth = (py/H-waterline)/height
            reflected = hex_rgb(spec.get("glow", {}).get("color", "#ffe0b4"))
            color = tuple(round(horizon[i]*(.5-.23*depth)+shadow[i]*(.5+.23*depth)) for i in range(3))
            draw.line((0, py, W, py), fill=(*color, 255))
            shimmer = max(0, math.sin(py*1.7)+math.sin(py*.47))*.11
            span = (.012+depth*.09)*W
            if shimmer > .04:
                cx = light_x + math.sin(py*.64)*span*.35
                glint = tuple(round(color[i]*(1-shimmer)+reflected[i]*shimmer) for i in range(3))
                draw.line((cx-span, py, cx+span, py), fill=(*glint, 255))
        return layer
    for depth in range(3):
        points = []
        step = max(1, W // 1200)
        for px in range(0, W + step, step):
            x = px / max(1, H)
            ridge = (1-height + depth*.055 +
                     (math.sin(x*2+depth*2)*.045 + math.sin(x*5.3+depth*3)*.018 +
                      math.sin(x*11+depth)*.006)*height/.2)
            if style == "alpine":
                peaks = abs(math.sin(x*1.9+depth*2.1))*.080+abs(math.sin(x*4.3+depth*.7))*.025
                ridge = 1-height+depth*.065+(peaks-.054+math.sin(x*19+depth)*.004)*height/.2
            elif style == "dunes":
                ridge = 1-height+depth*.055+(math.sin(x*1.7+depth*1.8)*.035+math.sin(x*3.1+depth)*.015)*height/.2
            points.append((px, round(ridge*H)))
        fog = (.6-depth*.23)*(.65+mist*.7)
        color = tuple(round(shadow[i]*(1-fog) + horizon[i]*fog) for i in range(3))
        draw.polygon([(0, H), *points, (W, H)], fill=(*color, 255))
        if style == "alpine":
            snowline = (1-height+.025+depth*.065)*H
            snow = tuple(round((stops[-1][i]*.68+stops[2][i]*.32)*(.45+.55*daylight)) for i in range(3))
            for px, py in points:
                bottom = round(snowline+math.sin(px/max(1,H)*31)*H*.007)
                if py < bottom:
                    draw.line((px, py, px, bottom), fill=(*snow, 255), width=step)
        elif style == "dunes":
            crest = tuple(round(color[i]*.75+stops[-1][i]*.25) for i in range(3))
            draw.line(points, fill=(*crest, 255), width=max(1, H//500))
    return layer


# ── frame composition ────────────────────────────────────────────────────────

def compose(scene, t: float, frame_seed: int) -> Image.Image:
    """Composite one frame. t in [0,1) is loop phase."""
    img = scene["base"].copy().convert("RGBA")

    # breathing glow
    if scene["glow_mask"] is not None:
        k = 1.0 + scene["glow_pulse"] * math.sin(2 * math.pi * t)
        mask = scene["glow_mask"].point(lambda v: min(255, int(v * k)))
        img = Image.composite(
            Image.new("RGBA", (W, H), (*scene["glow_c"], 255)), img, mask)

    # drifting celestial
    if scene["cel_tile"] is not None:
        cfg = scene["cel_cfg"]
        # slow arc: forward in x, slight bob in y; loops smoothly
        dx = cfg["drift"] * W * t
        dy = 0.01 * H * math.sin(2 * math.pi * t)
        cx = cfg["x"] * W + dx - scene["cel_tile"].width // 2
        cy = cfg["y"] * H + dy - scene["cel_tile"].height // 2
        img.alpha_composite(scene["cel_tile"], (int(cx), int(cy)))

    # twinkling stars
    if scene["stars"]:
        layer = Image.new("RGBA", (W, H), (0, 0, 0, 0))
        d = ImageDraw.Draw(layer)
        for s in scene["stars"]:
            tw = 0.45 + 0.55 * (0.5 + 0.5 * math.sin(s["speed"] * 6.283 * t + s["phase"]))
            b = s["b"]
            d.ellipse([s["x"] - s["r"], s["y"] - s["r"], s["x"] + s["r"], s["y"] + s["r"]],
                      fill=(b, b, min(255, b + 15), int(200 * tw)))
        layer = layer.filter(ImageFilter.GaussianBlur(0.5))
        img = Image.alpha_composite(img, layer)

    if scene["mesh"] is not None:
        img = Image.alpha_composite(img, scene["mesh"])

    if scene.get("landscape") is not None:
        img = Image.alpha_composite(img, scene["landscape"])

    img = img.convert("RGB")

    # shimmering film grain (per-frame seed)
    if scene["grain"] > 0:
        random.seed(frame_seed)
        noise = Image.effect_noise((W, H), 10).convert("L")
        img = Image.blend(img, Image.merge("RGB", (noise, noise, noise)), scene["grain"])

    if scene["vig"] is not None:
        img = Image.composite(img, Image.new("RGB", (W, H), (0, 0, 0)), scene["vig"])

    return img


# ── wallpaper plumbing ───────────────────────────────────────────────────────

def set_wallpaper(path: Path):
    uri = f"file://{path}"
    for key in ("picture-uri", "picture-uri-dark"):
        r = subprocess.run(["/usr/bin/gsettings", "set", "org.gnome.desktop.background", key, uri],
                           capture_output=True, text=True)
        if r.returncode != 0:
            print(f"gsettings failed: {r.stderr.strip()}", file=sys.stderr)
    subprocess.run(["/usr/bin/gsettings", "set", "org.gnome.desktop.background", "picture-options", "spanned"], check=False)


def render_still(spec, mesh_enabled: bool = True, landscape_enabled: bool = True):
    scene = build_scene(spec, mesh_enabled, landscape_enabled)
    img = compose(scene, 0.0, frame_seed=0)
    img = composite_selected_pack(img, spec.get("_living", {}))
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    img.save(OUT_PNG, "PNG")
    set_wallpaper(OUT_PNG)
    print(f"wrote {OUT_PNG}")


def render_frames(spec, n: int, mesh_enabled: bool = True, landscape_enabled: bool = True):
    scene = build_scene(spec, mesh_enabled, landscape_enabled)
    # Render into a staging dir, then atomically swap so --play never sees
    # half-written or missing frames.
    staging = FRAMES_DIR.with_name("frames.new")
    if staging.exists():
        for old in staging.glob("f*.png"):
            old.unlink()
    staging.mkdir(parents=True, exist_ok=True)
    for i in range(n):
        composite_selected_pack(compose(scene, i / n, frame_seed=i), spec.get("_living", {})).save(staging / f"f{i:03d}.png", "PNG")
    old_dir = FRAMES_DIR.with_name("frames.old")
    if FRAMES_DIR.exists():
        FRAMES_DIR.rename(old_dir)
    staging.rename(FRAMES_DIR)
    if old_dir.exists():
        for old in old_dir.glob("f*.png"):
            old.unlink()
        old_dir.rmdir()
    print(f"wrote {n} frames to {FRAMES_DIR}")


def play(frame_seconds: float = FRAME_SECONDS):
    """Legacy playback is intentionally disabled; kept as a migration guard."""
    raise RuntimeError("Use gnome-extensions enable dynwall@rucaradio; picture-uri playback is disabled")


def main(argv=None):
    global W, H, FRAME_SECONDS
    parser = argparse.ArgumentParser(description="Time-aware sky with native GPU weather")
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--preview-output", type=Path, metavar="PATH", help="Render the current offline preview to a file without changing wallpaper")
    modes.add_argument("--refresh-scene", action="store_true", help="Publish GPU state without network or changing wallpaper")
    modes.add_argument("--animate", nargs="?", const=None, default=argparse.SUPPRESS, type=int, metavar="N", help="Export legacy PNG frames (not desktop playback)")
    modes.add_argument("--play", action="store_true", help="Removed: use the native GNOME extension")
    args = parser.parse_args(argv)
    if args.play:
        print("Legacy picture-uri playback is disabled to avoid desktop stalls. Use: "
              "gnome-extensions enable dynwall@rucaradio", file=sys.stderr)
        return 2
    cfg = load_config()
    if not cfg["enabled"] and not args.preview_output:
        print("Dynwall is disabled in settings")
        return 0
    original_cfg = copy.deepcopy(cfg)
    W, H = cfg["width"], cfg["height"]
    FRAME_SECONDS = cfg["frame_seconds"]
    from dynwall_living import resolve_selection
    selected = resolve_selection(cfg, time.time())
    if isinstance(selected, dict):
        cfg.update({key: value for key, value in selected.items() if key in ("background", "landscape_pack", "scene_customization")})
    snapshot = load_weather()
    weather = weather_description(snapshot) if snapshot else "unknown"
    if args.preview_output:
        # Settings thumbnail rendering is entirely local and never changes scene or observations.
        request = None
        try:
            request = json.loads((CACHE_DIR / "preview.json").read_text())
        except (OSError, ValueError):
            pass
        clock = datetime.now()
        from dynwall_living import preview_scene, normalize_living_config
        presentation = preview_scene({}, request, time.time())
        if presentation['preview']:
            selection = request.get("selection")
            if isinstance(selection, dict):
                cfg = normalize_living_config({**cfg, **{key: value for key, value in selection.items()
                    if key in ("background", "landscape_pack", "scene_customization")}})
            clock = datetime.fromtimestamp(presentation['previewClock'] / 1000)
            weather = presentation['previewScenario']
        preview_scale = min(1, 1280 / W, 720 / H)
        W, H = max(1, round(W * preview_scale)), max(1, round(H * preview_scale))
        spec = background_spec(clock, cfg, weather) or fallback_spec(clock, weather)
        spec = customize_fallback_spec(spec, cfg.get("scene_customization"))
        image = compose(build_scene(spec, cfg["mesh_enabled"], cfg["landscape_enabled"]), 0, 0)
        image = composite_selected_pack(image, cfg)
        image = preview_weather_image(image, weather)
        args.preview_output.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        image.save(args.preview_output)
        print(f"preview {args.preview_output}")
        return 0
    themed = background_spec(datetime.now(), cfg, weather)
    if themed is None:
        themed = theme_spec(datetime.now(), cfg, snapshot)
    if themed is not None:
        spec = themed
    elif args.refresh_scene:
        # Settings changes never spend API tokens or touch the desktop image.
        try:
            spec = json.loads(SPEC_CACHE.read_text())["spec"]
            if not isinstance(spec, dict) or not isinstance(spec.get("gradient"), list) or len(spec["gradient"]) < 2:
                raise ValueError("invalid cached sky")
        except (OSError, ValueError, KeyError, TypeError):
            spec = fallback_spec(datetime.now(), weather)
    else:
        spec = get_spec(weather, cfg, snapshot)
    document = build_scene_document(spec, snapshot, cfg)
    document["sceneLibrary"] = build_scene_library()
    document["packs"] = build_pack_catalog()
    automatic = theme_spec(datetime.now(), original_cfg, snapshot)
    if automatic is None:
        try:
            automatic = json.loads(SPEC_CACHE.read_text())["spec"]
            if not isinstance(automatic, dict) or not isinstance(automatic.get("gradient"), list):
                raise ValueError("invalid cached automatic art")
        except (OSError, ValueError, KeyError, TypeError):
            automatic = fallback_spec(datetime.now(), weather)
    document["automaticSpec"] = automatic
    write_scene(CACHE_DIR / "scene.json", document)
    if args.refresh_scene:
        print(f"published {CACHE_DIR / 'scene.json'}")
        return 0
    spec = customize_fallback_spec(spec, cfg.get("scene_customization"))
    spec["_living"] = cfg
    print(f"title={spec.get('title')!r} mood={spec.get('mood')} gradient={spec['gradient']} weather={weather}")
    if hasattr(args, "animate"):
        if not cfg["allow_animation"]:
            print("animation disabled in config (allow_animation=false)", file=sys.stderr)
            return 1
        n = int(clamp(cfg["frames"] if args.animate is None else args.animate, 1, 120))
        render_frames(spec, n, cfg["mesh_enabled"], cfg["landscape_enabled"])
    else:
        render_still(spec, cfg["mesh_enabled"], cfg["landscape_enabled"])
    return 0


if __name__ == "__main__":
    sys.exit(main())
