def customize_fallback_spec(spec, customization):
    """Static counterpart of the native presentation controls; never mutate art."""
    result = copy.deepcopy(spec)
    c = customization if isinstance(customization, dict) else {}
    horizon = _float(c.get("horizon"), .8, .5, .95)
    scale = _float(c.get("terrain_scale"), 1, .5, 2)
    terrain = result["landscape"] = dict(result["landscape"]) if isinstance(result.get("landscape"), dict) else {}
    terrain["height"] = clamp((_float(terrain.get("height"), .2, .1, .3)+.8-horizon)*scale, .1, .3)
    terrain["mist"] = clamp(_float(terrain.get("mist"), .5, 0, 1)+_float(c.get("mist"), .5, 0, 1)-.5, 0, 1)
    warmth = _float(c.get("warmth"), 0, -1, 1)
    darkness = _float(c.get("darkness"), 0, 0, 1)
    def tint(color):
        channels = hex_rgb(color)
        return "#%02x%02x%02x" % tuple(round(clamp(value*(1-darkness*.65)+(warmth*18 if i==0 else -warmth*18 if i==2 else 0),0,255)) for i,value in enumerate(channels))
    result["gradient"] = [tint(color) for color in result["gradient"]]
    return result


