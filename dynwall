#!/usr/bin/env python3
"""Dynamic wallpaper generator + animator.

Renders a 3840x1080 spanned wallpaper: time-of-day gradient + weather-reactive
palette + geometric overlays, art-directed by an OpenAI model from the current
time and live weather (cached ~1 call/hour; deterministic fallback offline).

Modes:
  dynwall              render one still, apply as wallpaper
  dynwall --animate N  render an N-frame animation loop to ~/.cache/dynwall/frames
  dynwall --play       loop forever, cycling picture-uri through the frames

Motion: twinkling stars, breathing glow, slowly drifting celestial disc,
shimmering film grain. Frames are pre-rendered (cheap to cycle).
"""

import hashlib
import json
import math
import os
import random
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

from PIL import Image, ImageDraw, ImageFilter

W, H = 3840, 1080
CACHE_DIR = Path.home() / ".cache" / "dynwall"
SPEC_CACHE = CACHE_DIR / "spec.json"
OUT_PNG = CACHE_DIR / "wall.png"
FRAMES_DIR = CACHE_DIR / "frames"
CONFIG_FILE = Path.home() / ".config" / "dynwall" / "config.json"
FRAME_SECONDS = 1.5  # dwell per frame when playing

PROVIDERS = {
    "openai": {
        "url": "https://api.openai.com/v1/chat/completions",
        "default_model": "gpt-5.4-nano",
        "env_key": "OPENAI_API_KEY",
    },
    "openrouter": {
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "default_model": "openai/gpt-5.4-nano",
        "env_key": "OPENROUTER_API_KEY",
    },
}

DEFAULTS = {
    "provider": "openai",
    "api_key": "",
    "model": "",
    "prompt": "",
    "allow_network": True,
    "allow_animation": True,
    "frames": 24,
    "frame_seconds": 1.5,
    "width": 3840,
    "height": 1080,
    "mesh_enabled": True,
}

# Embedded copy of default_prompt.txt (kept in sync; used if the file is missing).
EMBEDDED_DEFAULT_PROMPT = """\
You are the art director for a generative desktop wallpaper engine. Design today's composition. Be bold and artistic — vary your style hour to hour; do NOT default to safe navy gradients. Explore: duotone, synthwave, misty minimalism, aurora, brutalist contrast, pastel haze, bioluminescent night, golden-hour warmth.
Return ONLY JSON:
{
  "title": "short poetic name",
  "gradient": ["#hex", ...],           // 2-5 color stops, top to bottom
  "gradient_positions": [0.0, ...],    // optional, same length, 0-1
  "accent": "#hex",                    // used for mesh facets + details
  "glow": {"color": "#hex", "x": 0-1, "y": 0-1, "size": 0.2-1.2, "intensity": 0-1, "pulse": 0-0.3} | null,
  "celestial": {"type": "sun"|"moon", "x": 0-1, "y": 0-1, "size": 0.03-0.15, "drift": 0-0.05} | null,
  "stars": 0-600,                      // starfield density; sensible only when dark
  "mesh": {"style": "lowpoly"|"lines"|"none", "density": 10-28, "opacity": 0.02-0.16},
  "grain": 0.0-0.06,
  "vignette": 0.0-1.0,
  "mood": "one word"
}
The engine animates: stars twinkle, the glow pulses (pulse = amplitude), the celestial disc drifts (drift = travel distance across the loop), and the film grain shimmers. Choose motion params that suit the mood.
Local time: {time}. Weather: {weather}. Canvas: 3840x1080 ultrawide spanning two monitors (vertical seam at x=0.5 — avoid placing key features exactly on it). Reflect the time of day and weather, but interpret freely."""


def _bool(v, default):
    return v if isinstance(v, bool) else default


def _int(v, default, lo, hi):
    try:
        return int(clamp(int(v), lo, hi))
    except (TypeError, ValueError):
        return default


def _float(v, default, lo, hi):
    try:
        return clamp(float(v), lo, hi)
    except (TypeError, ValueError):
        return default


def load_config() -> dict:
    """Load ~/.config/dynwall/config.json, tolerating missing/corrupt files.

    Missing keys fall back to DEFAULTS; values are type-checked and clamped.
    """
    cfg = dict(DEFAULTS)
    raw = {}
    if CONFIG_FILE.exists():
        try:
            data = json.loads(CONFIG_FILE.read_text())
            if isinstance(data, dict):
                raw = data
        except Exception as e:
            print(f"config: ignoring unreadable {CONFIG_FILE} ({e})", file=sys.stderr)

    provider = str(raw.get("provider", cfg["provider"])).lower()
    cfg["provider"] = provider if provider in ("openai", "openrouter", "none") else DEFAULTS["provider"]
    cfg["api_key"] = raw["api_key"] if isinstance(raw.get("api_key"), str) else ""
    cfg["model"] = raw["model"] if isinstance(raw.get("model"), str) else ""
    cfg["prompt"] = raw["prompt"] if isinstance(raw.get("prompt"), str) else ""
    for k in ("allow_network", "allow_animation", "mesh_enabled"):
        cfg[k] = _bool(raw.get(k), DEFAULTS[k])
    cfg["frames"] = _int(raw.get("frames"), DEFAULTS["frames"], 1, 120)
    cfg["frame_seconds"] = _float(raw.get("frame_seconds"), DEFAULTS["frame_seconds"], 0.5, 10.0)
    cfg["width"] = _int(raw.get("width"), DEFAULTS["width"], 1, 15360)
    cfg["height"] = _int(raw.get("height"), DEFAULTS["height"], 1, 15360)

    if cfg["provider"] in PROVIDERS:
        p = PROVIDERS[cfg["provider"]]
        if not cfg["api_key"]:
            cfg["api_key"] = os.environ.get(p["env_key"], "")
        if not cfg["model"]:
            cfg["model"] = p["default_model"]
    return cfg


def get_default_prompt() -> str:
    """Load default_prompt.txt shipped next to the script; embedded copy as fallback."""
    try:
        return (Path(__file__).resolve().parent / "default_prompt.txt").read_text()
    except Exception:
        return EMBEDDED_DEFAULT_PROMPT


# ── context ──────────────────────────────────────────────────────────────────

def get_weather(allow_network: bool = True):
    if not allow_network:
        return "unknown"
    try:
        import requests
        r = requests.get("https://wttr.in/?format=%t+%C", timeout=10)
        r.raise_for_status()
        return r.text.strip() or "unknown"
    except Exception as e:
        print(f"weather fetch failed ({e}); using 'unknown'", file=sys.stderr)
        return "unknown"


def get_spec(weather: str, cfg: dict) -> dict:
    now = datetime.now()
    key = f"{now:%Y-%m-%d-%H}|{weather}|{cfg['provider']}|{cfg['model']}|{hashlib.sha256(cfg['prompt'].encode()).hexdigest()}"

    if SPEC_CACHE.exists():
        try:
            cached = json.loads(SPEC_CACHE.read_text())
            if cached.get("key") == key:
                return cached["spec"]
        except Exception:
            pass

    spec = llm_spec(now, weather, cfg) or fallback_spec(now, weather)
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    SPEC_CACHE.write_text(json.dumps({"key": key, "spec": spec}))
    return spec


def llm_spec(now: datetime, weather: str, cfg: dict):
    if not cfg.get("allow_network", True):
        return None
    provider = cfg.get("provider", "openai")
    if provider == "none" or provider not in PROVIDERS:
        return None
    key = cfg.get("api_key") or os.environ.get(PROVIDERS[provider]["env_key"])
    if not key:
        return None
    template = cfg.get("prompt") or get_default_prompt()
    prompt = template.replace("{time}", f"{now:%A %H:%M}").replace("{weather}", weather)
    headers = {"Authorization": f"Bearer {key}"}
    if provider == "openrouter":
        headers["HTTP-Referer"] = "dynwall"
    try:
        import requests
        r = requests.post(
            PROVIDERS[provider]["url"],
            headers=headers,
            json={
                "model": cfg.get("model") or PROVIDERS[provider]["default_model"],
                "messages": [{"role": "user", "content": prompt}],
                "response_format": {"type": "json_object"},
                "max_completion_tokens": 400,
            },
            timeout=30,
        )
        r.raise_for_status()
        spec = json.loads(r.json()["choices"][0]["message"]["content"])
        # minimal validation
        assert isinstance(spec["gradient"], list) and len(spec["gradient"]) >= 2
        return spec
    except Exception as e:
        print(f"LLM spec failed ({e}); using fallback", file=sys.stderr)
        return None


def fallback_spec(now: datetime, weather: str):
    """Deterministic palette from approximate sun elevation."""
    h = now.hour + now.minute / 60
    # crude daylight window 6:00-20:00
    elev = math.sin(math.pi * (h - 6) / 14) if 6 <= h <= 20 else -0.3
    elev = max(-0.3, min(1.0, elev))

    def lerp(a, b, t):
        return tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))

    night = [(10, 12, 28), (18, 22, 48), (28, 26, 60)]
    dusk = [(38, 24, 54), (120, 58, 84), (224, 122, 95)]
    day = [(64, 116, 176), (126, 172, 208), (196, 216, 228)]

    t = (elev + 0.3) / 1.3
    if t < 0.5:
        stops = [lerp(night[i], dusk[i], t * 2) for i in range(3)]
    else:
        stops = [lerp(dusk[i], day[i], (t - 0.5) * 2) for i in range(3)]

    gray = "rain" in weather or "🌧" in weather or "☁" in weather or "🌫" in weather
    if gray:
        stops = [lerp(c, (sum(c) // 3,) * 3, 0.35) for c in stops]

    hx = lambda c: "#%02x%02x%02x" % c
    return {
        "title": "fallback",
        "gradient": [hx(c) for c in stops],
        "accent": "#e0b36a" if t >= 0.5 else "#7a86c8",
        "glow": None,
        "celestial": None,
        "stars": 200 if t < 0.35 else 0,
        "mesh": {"style": "lowpoly", "density": 18, "opacity": 0.08},
        "grain": 0.025,
        "vignette": 0.7,
        "mood": "fallback",
    }


# ── helpers ──────────────────────────────────────────────────────────────────

def hex_rgb(s):
    s = str(s).lstrip("#")[:6]
    return tuple(int(s[i:i + 2], 16) for i in (0, 2, 4))


def num(v, default):
    """Coerce LLM output to a float; handles '0.06-0.12' style ranges."""
    try:
        return float(v)
    except (TypeError, ValueError):
        import re
        vals = [float(x) for x in re.findall(r"\d+\.?\d*", str(v))]
        return sum(vals) / len(vals) if vals else default


def clamp(v, lo, hi):
    return max(lo, min(hi, v))


# ── layer building (static parts, computed once) ────────────────────────────

def build_scene(spec, mesh_enabled: bool = True):
    """Returns a dict of pre-built layers + animation params."""
    stops = [hex_rgb(c) for c in spec["gradient"][:5]]
    if len(stops) < 2:
        stops = [(10, 12, 28), (28, 26, 60)]
    accent = hex_rgb(spec.get("accent", "#888888"))
    glow = spec.get("glow") if isinstance(spec.get("glow"), dict) else None
    celestial = spec.get("celestial") if isinstance(spec.get("celestial"), dict) else None
    stars_n = int(clamp(num(spec.get("stars"), 0), 0, 600))
    mesh_cfg = spec.get("mesh") if isinstance(spec.get("mesh"), dict) else {}
    mesh_style = str(mesh_cfg.get("style", "lowpoly")) if mesh_enabled else "none"
    mesh_op = clamp(num(mesh_cfg.get("opacity", spec.get("mesh_opacity")), 0.08), 0.02, 0.16)
    density = int(clamp(num(mesh_cfg.get("density", spec.get("mesh_density")), 18), 10, 28))
    grain = clamp(num(spec.get("grain"), 0.025), 0.0, 0.06)
    vig_strength = clamp(num(spec.get("vignette"), 0.7), 0.0, 1.0)

    # gradient (built as 1×H strip, stretched — fast)
    positions = spec.get("gradient_positions")
    if not (isinstance(positions, list) and len(positions) == len(stops)):
        positions = [i / (len(stops) - 1) for i in range(len(stops))]
    positions = [clamp(num(p, i / (len(stops) - 1)), 0.0, 1.0)
                 for i, p in enumerate(positions)]
    strip = Image.new("RGB", (1, H))
    spx = strip.load()
    for y in range(H):
        t = y / (H - 1)
        i = 0
        while i < len(positions) - 2 and t > positions[i + 1]:
            i += 1
        p0, p1 = positions[i], positions[i + 1]
        f = 0.0 if p1 <= p0 else clamp((t - p0) / (p1 - p0), 0.0, 1.0)
        spx[0, y] = tuple(int(stops[i][k] + (stops[i + 1][k] - stops[i][k]) * f) for k in range(3))
    base = strip.resize((W, H))

    # glow: keep the L-mask separate so it can pulse per frame
    glow_mask = None
    glow_c = None
    glow_pulse = 0.0
    if glow:
        gx_f = clamp(num(glow.get("x"), 0.68), 0.05, 0.95)
        gy_f = clamp(num(glow.get("y"), 0.30), 0.0, 1.0)
        gsize = clamp(num(glow.get("size"), 0.8), 0.2, 1.2)
        gint = clamp(num(glow.get("intensity"), 0.8), 0.0, 1.0)
        glow_pulse = clamp(num(glow.get("pulse"), 0.15), 0.0, 0.3)
        glow_c = hex_rgb(glow.get("color", "#ffffff"))
        glow_x, glow_y = W * gx_f, H * gy_f
        glow_mask = Image.new("L", (W, H), 0)
        d = ImageDraw.Draw(glow_mask)
        r = int(H * gsize)
        for rr in range(r, 0, -6):
            a = int(110 * gint * (1 - rr / r) ** 2)
            d.ellipse([glow_x - rr, glow_y - rr, glow_x + rr, glow_y + rr], fill=a)
        glow_mask = glow_mask.filter(ImageFilter.GaussianBlur(60))
    else:
        glow_x, glow_y = W * 0.68, H * 0.30

    # celestial: rendered at origin into a tile so it can drift per frame
    cel_tile = None
    cel_cfg = None
    if celestial:
        ctype = str(celestial.get("type", "moon"))
        cr = H * clamp(num(celestial.get("size"), 0.07), 0.03, 0.15)
        cel_cfg = {
            "x": clamp(num(celestial.get("x"), 0.3), 0.05, 0.95),
            "y": clamp(num(celestial.get("y"), 0.25), 0.0, 1.0),
            "r": cr,
            "drift": clamp(num(celestial.get("drift"), 0.02), 0.0, 0.05),
        }
        pad = int(cr * 2.5) * 2
        cel_tile = Image.new("RGBA", (pad, pad), (0, 0, 0, 0))
        d = ImageDraw.Draw(cel_tile)
        ccx = ccy = pad // 2
        halo_c = (255, 244, 214) if ctype == "sun" else (210, 218, 240)
        for rr in range(int(cr * 2.2), int(cr), -3):
            a = int(60 * (1 - (rr - cr) / (cr * 1.2)))
            d.ellipse([ccx - rr, ccy - rr, ccx + rr, ccy + rr], fill=(*halo_c, a))
        d.ellipse([ccx - cr, ccy - cr, ccx + cr, ccy + cr], fill=(*halo_c, 235))
        if ctype == "moon":  # simple crater shading
            rng_c = random.Random(7)
            for _ in range(7):
                ang = rng_c.uniform(0, 6.283)
                dist = rng_c.uniform(0, cr * 0.7)
                mx, my = ccx + dist * math.cos(ang), ccy + dist * math.sin(ang)
                mr = rng_c.uniform(cr * 0.06, cr * 0.16)
                d.ellipse([mx - mr, my - mr, mx + mr, my + mr], fill=(160, 170, 200, 60))
        cel_tile = cel_tile.filter(ImageFilter.GaussianBlur(1.5))

    # stars: stored as data (twinkle computed per frame)
    stars = []
    if stars_n > 0:
        rng_s = random.Random(42)
        for _ in range(stars_n):
            stars.append({
                "x": rng_s.uniform(0, W),
                "y": rng_s.uniform(0, H * 0.9),
                "r": rng_s.choice([1, 1, 1, 2]),
                "b": rng_s.randint(90, 255),
                "phase": rng_s.uniform(0, 6.283),
                "speed": rng_s.uniform(0.5, 2.0),
            })

    # mesh overlay (static)
    rng = random.Random(int(time.time() // 1800))  # stable per half-hour
    mesh = Image.new("RGBA", (W, H), (0, 0, 0, 0))
    md = ImageDraw.Draw(mesh)
    if mesh_style == "lowpoly":
        cols, rows = density, max(3, density * H // W)
        gx, gy = W / cols, H / rows
        grid = []
        for r in range(rows + 1):
            row = []
            for c in range(cols + 1):
                jx = rng.uniform(-0.45, 0.45) * gx if 0 < c < cols else 0
                jy = rng.uniform(-0.45, 0.45) * gy if 0 < r < rows else 0
                row.append((c * gx + jx, r * gy + jy))
            grid.append(row)
        for r in range(rows):
            for c in range(cols):
                p00, p10 = grid[r][c], grid[r][c + 1]
                p01, p11 = grid[r + 1][c], grid[r + 1][c + 1]
                for tri in ((p00, p10, p11), (p00, p11, p01)):
                    cx = sum(p[0] for p in tri) / 3
                    cy = sum(p[1] for p in tri) / 3
                    lum = 1 - min(1.0, math.hypot(cx - glow_x, cy - glow_y) / (W * 0.45))
                    col = accent if rng.random() < 0.18 else (255, 255, 255)
                    alpha = int(255 * mesh_op * (0.25 + lum * 1.1) * rng.uniform(0.6, 1.3))
                    md.polygon(tri, fill=(*col, max(2, min(70, alpha))))
        mesh = mesh.filter(ImageFilter.GaussianBlur(0.5))
    elif mesh_style == "lines":
        step = max(14, H // density)
        for i, y in enumerate(range(0, H + step, step)):
            lum = 1 - min(1.0, abs(y - glow_y) / (H * 0.8))
            alpha = int(255 * mesh_op * (0.3 + lum))
            col = accent if i % 4 == 0 else (255, 255, 255)
            pts = [(x, y + 6 * math.sin(x / W * 6.28 * 2 + i)) for x in range(0, W + 40, 40)]
            md.line(pts, fill=(*col, max(2, min(80, alpha))), width=2)

    # vignette (static)
    vig = None
    if vig_strength > 0:
        vig = Image.new("L", (W, H), 0)
        vd = ImageDraw.Draw(vig)
        vd.ellipse([-W * 0.15, -H * 0.35, W * 1.15, H * 1.35], fill=int(255 * vig_strength))
        vig = vig.filter(ImageFilter.GaussianBlur(220))

    return {
        "base": base, "glow_mask": glow_mask, "glow_c": glow_c,
        "glow_pulse": glow_pulse, "cel_tile": cel_tile, "cel_cfg": cel_cfg,
        "stars": stars, "mesh": mesh if mesh_style != "none" else None,
        "grain": grain, "vig": vig,
    }


# ── frame composition ────────────────────────────────────────────────────────

def compose(scene, t: float, frame_seed: int) -> Image.Image:
    """Composite one frame. t in [0,1) is loop phase."""
    img = scene["base"].copy().convert("RGBA")

    # breathing glow
    if scene["glow_mask"] is not None:
        k = 1.0 + scene["glow_pulse"] * math.sin(2 * math.pi * t)
        mask = scene["glow_mask"].point(lambda v: min(255, int(v * k)))
        img = Image.composite(
            Image.new("RGBA", (W, H), (*scene["glow_c"], 255)), img, mask)

    # drifting celestial
    if scene["cel_tile"] is not None:
        cfg = scene["cel_cfg"]
        # slow arc: forward in x, slight bob in y; loops smoothly
        dx = cfg["drift"] * W * t
        dy = 0.01 * H * math.sin(2 * math.pi * t)
        cx = cfg["x"] * W + dx - scene["cel_tile"].width // 2
        cy = cfg["y"] * H + dy - scene["cel_tile"].height // 2
        img.alpha_composite(scene["cel_tile"], (int(cx), int(cy)))

    # twinkling stars
    if scene["stars"]:
        layer = Image.new("RGBA", (W, H), (0, 0, 0, 0))
        d = ImageDraw.Draw(layer)
        for s in scene["stars"]:
            tw = 0.45 + 0.55 * (0.5 + 0.5 * math.sin(s["speed"] * 6.283 * t + s["phase"]))
            b = s["b"]
            d.ellipse([s["x"] - s["r"], s["y"] - s["r"], s["x"] + s["r"], s["y"] + s["r"]],
                      fill=(b, b, min(255, b + 15), int(200 * tw)))
        layer = layer.filter(ImageFilter.GaussianBlur(0.5))
        img = Image.alpha_composite(img, layer)

    if scene["mesh"] is not None:
        img = Image.alpha_composite(img, scene["mesh"])

    img = img.convert("RGB")

    # shimmering film grain (per-frame seed)
    if scene["grain"] > 0:
        random.seed(frame_seed)
        noise = Image.effect_noise((W, H), 10).convert("L")
        img = Image.blend(img, Image.merge("RGB", (noise, noise, noise)), scene["grain"])

    if scene["vig"] is not None:
        img = Image.composite(img, Image.new("RGB", (W, H), (0, 0, 0)), scene["vig"])

    return img


# ── wallpaper plumbing ───────────────────────────────────────────────────────

def set_wallpaper(path: Path):
    uri = f"file://{path}"
    for key in ("picture-uri", "picture-uri-dark"):
        r = subprocess.run(["/usr/bin/gsettings", "set", "org.gnome.desktop.background", key, uri],
                           capture_output=True, text=True)
        if r.returncode != 0:
            print(f"gsettings failed: {r.stderr.strip()}", file=sys.stderr)
    subprocess.run(["/usr/bin/gsettings", "set", "org.gnome.desktop.background", "picture-options", "spanned"], check=False)


def render_still(spec, mesh_enabled: bool = True):
    scene = build_scene(spec, mesh_enabled)
    img = compose(scene, 0.0, frame_seed=0)
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    img.save(OUT_PNG, "PNG")
    set_wallpaper(OUT_PNG)
    print(f"wrote {OUT_PNG}")


def render_frames(spec, n: int, mesh_enabled: bool = True):
    scene = build_scene(spec, mesh_enabled)
    # Render into a staging dir, then atomically swap so --play never sees
    # half-written or missing frames.
    staging = FRAMES_DIR.with_name("frames.new")
    if staging.exists():
        for old in staging.glob("f*.png"):
            old.unlink()
    staging.mkdir(parents=True, exist_ok=True)
    for i in range(n):
        compose(scene, i / n, frame_seed=i).save(staging / f"f{i:03d}.png", "PNG")
    old_dir = FRAMES_DIR.with_name("frames.old")
    if FRAMES_DIR.exists():
        FRAMES_DIR.rename(old_dir)
    staging.rename(FRAMES_DIR)
    if old_dir.exists():
        for old in old_dir.glob("f*.png"):
            old.unlink()
        old_dir.rmdir()
    print(f"wrote {n} frames to {FRAMES_DIR}")


def play(frame_seconds: float = FRAME_SECONDS):
    frames = sorted(FRAMES_DIR.glob("f*.png"))
    if len(frames) < 2:
        print("no frames; run: dynwall --animate 30", file=sys.stderr)
        sys.exit(1)
    subprocess.run(["/usr/bin/gsettings", "set", "org.gnome.desktop.background",
                    "picture-options", "spanned"], check=False)
    i = 0
    while True:
        uri = f"file://{frames[i]}"
        for key in ("picture-uri", "picture-uri-dark"):
            r = subprocess.run(["/usr/bin/gsettings", "set", "org.gnome.desktop.background", key, uri],
                               capture_output=True, text=True)
            if r.returncode != 0:
                print(f"gsettings failed: {r.stderr.strip()}", file=sys.stderr, flush=True)
        print(f"frame {i}: {uri}", flush=True)
        i = (i + 1) % len(frames)
        time.sleep(frame_seconds)


if __name__ == "__main__":
    cfg = load_config()
    W, H = cfg["width"], cfg["height"]
    FRAME_SECONDS = cfg["frame_seconds"]

    args = sys.argv[1:]
    if args and args[0] == "--play":
        play(FRAME_SECONDS)
    weather = get_weather(cfg["allow_network"])
    spec = get_spec(weather, cfg)
    print(f"title={spec.get('title')!r} mood={spec.get('mood')} gradient={spec['gradient']} weather={weather}")
    if args and args[0] == "--animate":
        if not cfg["allow_animation"]:
            print("animation disabled in config (allow_animation=false)", file=sys.stderr)
            sys.exit(1)
        try:
            n = int(args[1]) if len(args) > 1 else cfg["frames"]
        except ValueError:
            print(f"usage: dynwall --animate [N]  (N must be an integer, got {args[1]!r})", file=sys.stderr)
            sys.exit(2)
        n = int(clamp(n, 1, 120))
        render_frames(spec, n, cfg["mesh_enabled"])
    else:
        render_still(spec, cfg["mesh_enabled"])
