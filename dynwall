def get_weather(allow_network: bool = True):
    if not allow_network:
        return "unknown"
    try:
        import requests
        r = requests.get("https://wttr.in/?format=%t+%C", timeout=10)
        r.raise_for_status()
        return r.text.strip() or "unknown"
    except Exception as e:
        print(f"weather fetch failed ({e}); using 'unknown'", file=sys.stderr)
        return "unknown"


def theme_spec(now: datetime, cfg: dict, snapshot=None):
    """Resolve an explicitly selected local preset, before its local-date cutoff."""
    from datetime import date
    if cfg.get("theme") != "halloween":
        return None
    until = cfg.get("theme_until", "")
    if until != "":
        try:
            if now.date() >= date.fromisoformat(until):
                return None
        except (TypeError, ValueError):
            return None
    try:
        current = snapshot.get("current", {}) if isinstance(snapshot, dict) else {}
        observed_night = current.get("isNight")
        night = observed_night if isinstance(observed_night, bool) else not 7 <= now.hour < 18
        name = "halloween.json" if night else "halloween-day.json"
        return json.loads((Path(__file__).resolve().parent / "themes" / name).read_text())
    except (OSError, ValueError):
        return None


