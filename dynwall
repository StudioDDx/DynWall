def _bool(v, default):
    return v if isinstance(v, bool) else default


def _int(v, default, lo, hi):
    if isinstance(v, bool):
        return default
    try:
        return int(clamp(int(v), lo, hi))
    except (TypeError, ValueError, OverflowError):
        return default


def _float(v, default, lo, hi):
    if isinstance(v, bool):
        return default
    try:
        value = float(v)
        return clamp(value, lo, hi) if math.isfinite(value) else default
    except (TypeError, ValueError, OverflowError):
        return default


def load_config() -> dict:
    """Load ~/.config/dynwall/config.json, tolerating missing/corrupt files.

    Missing keys fall back to DEFAULTS; values are type-checked and clamped.
    """
    cfg = dict(DEFAULTS)
    raw = {}
    if CONFIG_FILE.exists():
        try:
            data = json.loads(CONFIG_FILE.read_text())
            if isinstance(data, dict):
                raw = data
        except Exception as e:
            print(f"config: ignoring unreadable {CONFIG_FILE} ({e})", file=sys.stderr)

    provider = str(raw.get("provider", cfg["provider"])).lower()
    cfg["provider"] = provider if provider in ("openai", "openrouter", "none") else DEFAULTS["provider"]
    cfg["api_key"] = raw["api_key"] if isinstance(raw.get("api_key"), str) else ""
    cfg["model"] = raw["model"] if isinstance(raw.get("model"), str) else ""
    cfg["prompt"] = raw["prompt"] if isinstance(raw.get("prompt"), str) else ""
    for k in ("theme", "theme_until", "background"):
        cfg[k] = raw[k] if isinstance(raw.get(k), str) else ""
    for k in ("enabled", "allow_network", "allow_animation", "mesh_enabled", "seasonal_effects", "landscape_enabled"):
        cfg[k] = _bool(raw.get(k), DEFAULTS[k])
    cfg["frames"] = _int(raw.get("frames"), DEFAULTS["frames"], 1, 120)
    cfg["frame_seconds"] = _float(raw.get("frame_seconds"), DEFAULTS["frame_seconds"], 0.5, 10.0)
    cfg["width"] = _int(raw.get("width"), DEFAULTS["width"], 1, 15360)
    cfg["height"] = _int(raw.get("height"), DEFAULTS["height"], 1, 15360)
    cfg["weather_fps"] = _int(raw.get("weather_fps"), 30, 15, 60)
    cfg["weather_quality"] = raw.get("weather_quality", "balanced")
    if cfg["weather_quality"] not in ("low", "balanced", "high"):
        cfg["weather_quality"] = "balanced"

    from dynwall_living import normalize_living_config
    cfg.update(normalize_living_config({**raw, **cfg}))

    if cfg["provider"] in PROVIDERS:
        p = PROVIDERS[cfg["provider"]]
        cfg["api_key"] = os.environ.get(p["env_key"], "").strip() or cfg["api_key"]
        if not cfg["model"]:
            cfg["model"] = p["default_model"]
    return cfg


