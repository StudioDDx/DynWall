    # --- helpers ------------------------------------------------------------

    def _selected_provider(self):
        return PROVIDERS[self.provider_row.get_selected()]

    def _update_model_placeholder(self):
        default = DEFAULT_MODELS.get(self._selected_provider(), "")
        self.model_row.set_tooltip_text(
            f"Leave empty to use the default: {default}" if default
            else "Model name (unused when provider is None)"
        )

    def _update_sensitivity(self):
        enabled = self.master_row.get_active()
        provider = self._selected_provider()
        network = self.network_row.get_active()
        sensitive = enabled and provider != "none" and network
        self.background_row.set_sensitive(enabled)
        self.network_row.set_sensitive(enabled)
        self.animation_row.set_sensitive(enabled)
        self.key_row.set_sensitive(enabled and provider != "none")
        self.model_row.set_sensitive(sensitive)
        self.fps_row.set_sensitive(enabled and self.animation_row.get_active())
        self.quality_row.set_sensitive(enabled and self.animation_row.get_active())
        self.seasonal_row.set_sensitive(enabled and self.animation_row.get_active())

    def _collect(self):
        buf = self.prompt_view.get_buffer()
        cfg = {
            "enabled": self.master_row.get_active(),
            "provider": self._selected_provider(),
            "api_key": self.key_row.get_text().strip(),
            "model": self.model_row.get_text().strip(),
            "prompt": buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).strip(),
            "theme": self.cfg["theme"],
            "theme_until": self.cfg["theme_until"],
            "background": BACKGROUNDS[self.background_row.get_selected()],
            "allow_network": self.network_row.get_active(),
            "allow_animation": self.animation_row.get_active(),
            "seasonal_effects": self.seasonal_row.get_active(),
            "frames": self.cfg["frames"],
            "frame_seconds": self.cfg["frame_seconds"],
            "weather_fps": int(self.fps_row.get_value()),
            "weather_quality": ["low", "balanced", "high"][self.quality_row.get_selected()],
            "width": int(self.width_row.get_value()),
            "height": int(self.height_row.get_value()),
            "mesh_enabled": self.mesh_row.get_active(),
            "landscape_enabled": self.landscape_row.get_active(),
        }
        cfg = {**self.cfg, **cfg}
        return collect_living(self, cfg) if getattr(self, "_living_ready", False) else cfg

    def _toast(self, msg):
        self.toast_overlay.add_toast(Adw.Toast(title=msg, timeout=3))

    # --- callbacks ----------------------------------------------------------

    def _on_background_changed(self, *_):
        selected = self.background_row.get_selected()
        name = BACKGROUNDS[selected]
        repo = find_repo_dir()
        preview = os.path.join(repo, "docs", "previews", "scenes", f"{name}-day.jpg") if repo else ""
        self.scene_preview.set_visible(os.path.isfile(preview))
        if os.path.isfile(preview):
            self.scene_preview.set_filename(preview)
        self.scene_description.set_text(BACKGROUND_DESCRIPTIONS[selected] +
                                       " Preview shows illustrative daytime weather.")

    def _on_provider_changed(self, *_):
        self._update_model_placeholder()
        self._update_sensitivity()

    def _on_revert_prompt(self, _btn):
        text = load_default_prompt()
        if text is None:
            self._toast("default_prompt.txt not found in the dynwall repo")
            return
        self.prompt_view.get_buffer().set_text(text.rstrip("\n"))
        self._toast("Default prompt loaded — press Save to apply")

    def _do_save(self, refresh_scene=True):
        cfg = self._collect()
        try:
            save_config(cfg)
        except (OSError, ValueError, TypeError) as exc:
            dialog = Adw.MessageDialog(
                transient_for=self,
                heading="Could not save settings",
                body=str(exc),
            )
            dialog.add_response("ok", "OK")
            dialog.present()
            return False
        if not sync_play_service(cfg["allow_animation"]):
            self._toast("Saved, but could not stop the legacy animation service")
        state_ok, state_errors = sync_dynwall_state(cfg["enabled"])
        if not state_ok:
            self._toast("Saved, but desktop state could not fully update: " + state_errors[0][-160:])
        self.cfg = cfg
        if refresh_scene and cfg["enabled"]:
            try:
                subprocess.Popen([DYNWALL_CMD, "--refresh-scene"],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 start_new_session=True)
            except OSError as exc:
                self._toast(f"Saved, but GPU state could not refresh: {exc}")
        return True

    def _on_save(self, _btn):
        if self._do_save():
            self._toast("Settings saved" if self.cfg["enabled"] else "Dynwall disabled; Ubuntu wallpaper restored")

    def _on_save_and_regen(self, btn):
        if not self._do_save(refresh_scene=False):
            return
        if not self.cfg["enabled"]:
            self._toast("Dynwall disabled; Ubuntu wallpaper restored")
            return
        btn.set_sensitive(False)
        self._toast("Saved — regenerating wallpaper in the background…")
        try:
            cmd = [DYNWALL_CMD]
            subprocess.Popen(
                cmd,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError as exc:
            self._toast(f"Could not launch dynwall: {exc}")
        GLib.timeout_add_seconds(5, lambda: (btn.set_sensitive(True), False)[1])


class DynwallSettingsApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_activate(self):
        win = self.get_active_window()
        if win is None:
            win = SettingsWindow(self)
        win.present()


def main():
    Adw.init()
    app = DynwallSettingsApp()
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
