def find_repo_dir():
    """Locate the dynwall repo dir (where default_prompt.txt lives)."""
    candidates = []
    # Resolve the ~/.local/bin/dynwall symlink target.
    try:
        target = os.path.realpath(BIN_LINK)
        candidates.append(os.path.dirname(target))
    except OSError:
        pass
    # Fall back to script-relative.
    candidates.append(os.path.dirname(os.path.realpath(__file__)))
    for d in candidates:
        if d and os.path.isfile(os.path.join(d, "default_prompt.txt")):
            return d
    return candidates[0] if candidates else None


def load_default_prompt():
    repo = find_repo_dir()
    if repo:
        try:
            with open(os.path.join(repo, "default_prompt.txt"), encoding="utf-8") as f:
                return f.read()
        except OSError:
            pass
    return None


def load_config():
    """Read config.json, tolerating a missing or corrupt file."""
    cfg = dict(DEFAULTS)
    try:
        with open(CONFIG_PATH, encoding="utf-8") as f:
            data = json.load(f)
        if isinstance(data, dict):
            cfg.update({key: value for key, value in data.items() if key not in DEFAULTS})
            for key, default in DEFAULTS.items():
                value = data.get(key)
                if type(value) is type(default) or (
                    type(default) is float and type(value) is int
                ):
                    if type(default) is float:
                        try:
                            value = float(value)
                        except OverflowError:
                            continue
                        if not math.isfinite(value):
                            continue
                    cfg[key] = value
    except (OSError, ValueError):
        pass
    # Clamp numeric ranges.
    cfg["frames"] = max(1, min(120, int(cfg["frames"])))
    cfg["frame_seconds"] = max(0.5, min(10.0, float(cfg["frame_seconds"])))
    cfg["width"] = max(1, min(15360, int(cfg["width"])))
    cfg["height"] = max(1, min(15360, int(cfg["height"])))
    cfg["weather_fps"] = max(15, min(60, int(cfg["weather_fps"])))
    if cfg["weather_quality"] not in ("low", "balanced", "high"):
        cfg["weather_quality"] = "balanced"
    if cfg["provider"] not in PROVIDERS:
        cfg["provider"] = DEFAULTS["provider"]
    if cfg["background"] not in BACKGROUNDS:
        cfg["background"] = "auto"
    return normalize_living_config(cfg)


def save_config(cfg):
    """Publish a complete, owner-only config while preserving the last good save."""
    os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
    temporary_path = None
    try:
        # A sibling file keeps replacement atomic; NamedTemporaryFile creates it
        # with mode 0600 before any API key is written.
        with tempfile.NamedTemporaryFile(
            mode="w", encoding="utf-8", dir=CONFIG_DIR,
            prefix=".config.json.", suffix=".tmp", delete=False,
        ) as f:
            temporary_path = f.name
            json.dump(cfg, f, indent=2, allow_nan=False)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(temporary_path, CONFIG_PATH)
        temporary_path = None
    finally:
        if temporary_path is not None:
            os.unlink(temporary_path)


def sync_play_service(enabled: bool) -> bool:
    """Retire the unsafe legacy player; animation now belongs to the GPU extension."""
    cmd = ["disable", "--now"]
    try:
        r = subprocess.run(["systemctl", "--user", *cmd, "dynwall-play.service"],
                           capture_output=True, text=True, timeout=15)
        return r.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def sync_dynwall_state(enabled: bool):
    """Apply the master state while touching only resources owned by Dynwall."""
    commands = [
        ["systemctl", "--user", "enable" if enabled else "disable", "--now", "dynwall.timer"],
        ["gnome-extensions", "enable" if enabled else "disable", "dynwall@rucaradio"],
    ]
    if enabled and WALLPAPER_PATH.is_file():
        uri = WALLPAPER_PATH.resolve().as_uri()
        commands.extend([
            ["/usr/bin/gsettings", "set", "org.gnome.desktop.background", "picture-uri", uri],
            ["/usr/bin/gsettings", "set", "org.gnome.desktop.background", "picture-uri-dark", uri],
            ["/usr/bin/gsettings", "set", "org.gnome.desktop.background", "picture-options", "spanned"],
        ])
    elif not enabled:
        commands.extend([
            ["/usr/bin/gsettings", "reset", "org.gnome.desktop.background", "picture-uri"],
            ["/usr/bin/gsettings", "reset", "org.gnome.desktop.background", "picture-uri-dark"],
            ["/usr/bin/gsettings", "reset", "org.gnome.desktop.background", "picture-options"],
        ])
    errors = []
    for command in commands:
        try:
            result = subprocess.run(command, capture_output=True, text=True, timeout=15)
            if result.returncode:
                errors.append((result.stderr or result.stdout or "command failed").strip())
        except (OSError, subprocess.SubprocessError) as error:
            errors.append(str(error))
    return not errors, errors


