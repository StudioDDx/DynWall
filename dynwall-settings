#!/usr/bin/python3
"""dynwall-settings — GTK4/libadwaita settings editor for dynwall.

Edits ~/.config/dynwall/config.json per the dynwall settings contract.
Runs with the system python3 (requires PyGObject + GTK4 + libadwaita).
"""

import json
import os
import stat
import subprocess
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk

APP_ID = "io.github.dynwall.Settings"
CONFIG_DIR = os.path.expanduser("~/.config/dynwall")
CONFIG_PATH = os.path.join(CONFIG_DIR, "config.json")
BIN_LINK = os.path.expanduser("~/.local/bin/dynwall")
DYNWALL_CMD = os.path.expanduser("~/.local/bin/dynwall")

DEFAULTS = {
    "provider": "openai",
    "api_key": "",
    "model": "",
    "prompt": "",
    "allow_network": True,
    "allow_animation": True,
    "frames": 24,
    "frame_seconds": 1.5,
    "width": 3840,
    "height": 1080,
    "mesh_enabled": True,
}

PROVIDERS = ["openai", "openrouter", "none"]
PROVIDER_LABELS = {"openai": "OpenAI", "openrouter": "OpenRouter", "none": "None (offline)"}
DEFAULT_MODELS = {"openai": "gpt-5.4-nano", "openrouter": "openai/gpt-5.4-nano", "none": ""}


def find_repo_dir():
    """Locate the dynwall repo dir (where default_prompt.txt lives)."""
    candidates = []
    # Resolve the ~/.local/bin/dynwall symlink target.
    try:
        target = os.path.realpath(BIN_LINK)
        candidates.append(os.path.dirname(target))
    except OSError:
        pass
    # Fall back to script-relative.
    candidates.append(os.path.dirname(os.path.realpath(__file__)))
    for d in candidates:
        if d and os.path.isfile(os.path.join(d, "default_prompt.txt")):
            return d
    return candidates[0] if candidates else None


def load_default_prompt():
    repo = find_repo_dir()
    if repo:
        try:
            with open(os.path.join(repo, "default_prompt.txt"), encoding="utf-8") as f:
                return f.read()
        except OSError:
            pass
    return None


def load_config():
    """Read config.json, tolerating a missing or corrupt file."""
    cfg = dict(DEFAULTS)
    try:
        with open(CONFIG_PATH, encoding="utf-8") as f:
            data = json.load(f)
        if isinstance(data, dict):
            for key in DEFAULTS:
                if key in data and isinstance(data[key], type(DEFAULTS[key])):
                    cfg[key] = data[key]
    except (OSError, ValueError):
        pass
    # Clamp numeric ranges.
    cfg["frames"] = max(1, min(120, int(cfg["frames"])))
    cfg["frame_seconds"] = max(0.5, min(10.0, float(cfg["frame_seconds"])))
    cfg["width"] = max(1, int(cfg["width"]))
    cfg["height"] = max(1, int(cfg["height"]))
    if cfg["provider"] not in PROVIDERS:
        cfg["provider"] = DEFAULTS["provider"]
    return cfg


def save_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG_PATH, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")
    # Config holds the API key — owner-only.
    os.chmod(CONFIG_PATH, stat.S_IRUSR | stat.S_IWUSR)


class SettingsWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Dynwall Settings")
        self.set_default_size(560, 720)
        self.cfg = load_config()

        page = Adw.PreferencesPage()

        # --- Provider group -------------------------------------------------
        provider_group = Adw.PreferencesGroup(title="AI Provider")
        page.add(provider_group)

        self.provider_row = Adw.ComboRow(title="Provider")
        model_list = Gtk.StringList.new([PROVIDER_LABELS[p] for p in PROVIDERS])
        self.provider_row.set_model(model_list)
        self.provider_row.set_selected(PROVIDERS.index(self.cfg["provider"]))
        self.provider_row.connect("notify::selected", self._on_provider_changed)
        provider_group.add(self.provider_row)

        self.key_row = Adw.PasswordEntryRow(title="API key")
        self.key_row.set_text(self.cfg["api_key"])
        provider_group.add(self.key_row)

        key_note = Gtk.Label(
            label="Leave empty to fall back to $OPENAI_API_KEY / $OPENROUTER_API_KEY.",
            xalign=0,
            wrap=True,
        )
        key_note.add_css_class("dim-label")
        key_note.add_css_class("caption")
        key_note.set_margin_start(12)
        key_note.set_margin_end(12)
        key_note.set_margin_bottom(6)
        provider_group.add(key_note)

        self.model_row = Adw.EntryRow(title="Model")
        self.model_row.set_text(self.cfg["model"])
        provider_group.add(self.model_row)
        self._update_model_placeholder()

        # --- Prompt group ---------------------------------------------------
        prompt_group = Adw.PreferencesGroup(
            title="Art-director prompt",
            description="Leave empty to use the built-in default prompt.",
        )
        page.add(prompt_group)

        prompt_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        prompt_box.set_margin_top(6)
        prompt_box.set_margin_bottom(12)
        prompt_box.set_margin_start(12)
        prompt_box.set_margin_end(12)

        scrolled = Gtk.ScrolledWindow(min_content_height=180, vexpand=False)
        scrolled.set_has_frame(True)
        self.prompt_view = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, monospace=True)
        self.prompt_view.set_top_margin(6)
        self.prompt_view.set_bottom_margin(6)
        self.prompt_view.set_left_margin(6)
        self.prompt_view.set_right_margin(6)
        self.prompt_view.get_buffer().set_text(self.cfg["prompt"])
        scrolled.set_child(self.prompt_view)
        prompt_box.append(scrolled)

        revert_btn = Gtk.Button(label="Revert to default prompt", halign=Gtk.Align.START)
        revert_btn.add_css_class("flat")
        revert_btn.connect("clicked", self._on_revert_prompt)
        prompt_box.append(revert_btn)

        prompt_row = Adw.PreferencesRow()
        prompt_row.set_child(prompt_box)
        prompt_group.add(prompt_row)

        # --- Behavior group -------------------------------------------------
        behavior_group = Adw.PreferencesGroup(title="Behavior")
        page.add(behavior_group)

        self.network_row = Adw.SwitchRow(
            title="Allow network access",
            subtitle="Off = no API calls and no weather fetch (pure fallback palette)",
        )
        self.network_row.set_active(self.cfg["allow_network"])
        self.network_row.connect("notify::active", lambda *_: self._update_sensitivity())
        behavior_group.add(self.network_row)

        self.animation_row = Adw.SwitchRow(
            title="Allow animation",
            subtitle="Enable frame pre-rendering for animated wallpapers",
        )
        self.animation_row.set_active(self.cfg["allow_animation"])
        self.animation_row.connect("notify::active", lambda *_: self._update_sensitivity())
        behavior_group.add(self.animation_row)

        self.mesh_row = Adw.SwitchRow(
            title="Mesh gradient",
            subtitle="Blend palette colors into a mesh background",
        )
        self.mesh_row.set_active(self.cfg["mesh_enabled"])
        behavior_group.add(self.mesh_row)

        self.frames_row = Adw.SpinRow.new_with_range(1, 120, 1)
        self.frames_row.set_title("Animation frames")
        self.frames_row.set_value(self.cfg["frames"])
        behavior_group.add(self.frames_row)

        self.seconds_row = Adw.SpinRow.new_with_range(0.5, 10.0, 0.1)
        self.seconds_row.set_title("Seconds per frame")
        self.seconds_row.set_digits(1)
        self.seconds_row.set_value(self.cfg["frame_seconds"])
        behavior_group.add(self.seconds_row)

        # --- Canvas group ---------------------------------------------------
        canvas_group = Adw.PreferencesGroup(title="Canvas")
        page.add(canvas_group)

        self.width_row = Adw.SpinRow.new_with_range(1, 15360, 1)
        self.width_row.set_title("Width (px)")
        self.width_row.set_value(self.cfg["width"])
        canvas_group.add(self.width_row)

        self.height_row = Adw.SpinRow.new_with_range(1, 15360, 1)
        self.height_row.set_title("Height (px)")
        self.height_row.set_value(self.cfg["height"])
        canvas_group.add(self.height_row)

        # --- Buttons --------------------------------------------------------
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        scroller = Gtk.ScrolledWindow(vexpand=True)
        scroller.set_child(page)
        outer.append(scroller)

        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        btn_box.set_halign(Gtk.Align.END)
        btn_box.set_margin_top(12)
        btn_box.set_margin_bottom(12)
        btn_box.set_margin_start(12)
        btn_box.set_margin_end(12)

        self.regen_btn = Gtk.Button(label="Save && Regenerate now")
        self.regen_btn.connect("clicked", self._on_save_and_regen)
        btn_box.append(self.regen_btn)

        save_btn = Gtk.Button(label="Save")
        save_btn.add_css_class("suggested-action")
        save_btn.connect("clicked", self._on_save)
        btn_box.append(save_btn)

        outer.append(btn_box)

        self.toast_overlay = Adw.ToastOverlay()
        self.toast_overlay.set_child(outer)
        self.set_content(self.toast_overlay)

        self._update_sensitivity()

    # --- helpers ------------------------------------------------------------

    def _selected_provider(self):
        return PROVIDERS[self.provider_row.get_selected()]

    def _update_model_placeholder(self):
        default = DEFAULT_MODELS.get(self._selected_provider(), "")
        self.model_row.set_tooltip_text(
            f"Leave empty to use the default: {default}" if default
            else "Model name (unused when provider is None)"
        )

    def _update_sensitivity(self):
        provider = self._selected_provider()
        network = self.network_row.get_active()
        sensitive = provider != "none" and network
        self.key_row.set_sensitive(provider != "none")
        self.model_row.set_sensitive(sensitive)
        self.frames_row.set_sensitive(self.animation_row.get_active())
        self.seconds_row.set_sensitive(self.animation_row.get_active())

    def _collect(self):
        buf = self.prompt_view.get_buffer()
        cfg = {
            "provider": self._selected_provider(),
            "api_key": self.key_row.get_text().strip(),
            "model": self.model_row.get_text().strip(),
            "prompt": buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).strip(),
            "allow_network": self.network_row.get_active(),
            "allow_animation": self.animation_row.get_active(),
            "frames": int(self.frames_row.get_value()),
            "frame_seconds": round(float(self.seconds_row.get_value()), 2),
            "width": int(self.width_row.get_value()),
            "height": int(self.height_row.get_value()),
            "mesh_enabled": self.mesh_row.get_active(),
        }
        return cfg

    def _toast(self, msg):
        self.toast_overlay.add_toast(Adw.Toast(title=msg, timeout=3))

    # --- callbacks ----------------------------------------------------------

    def _on_provider_changed(self, *_):
        self._update_model_placeholder()
        self._update_sensitivity()

    def _on_revert_prompt(self, _btn):
        text = load_default_prompt()
        if text is None:
            self._toast("default_prompt.txt not found in the dynwall repo")
            return
        self.prompt_view.get_buffer().set_text(text.rstrip("\n"))
        self._toast("Default prompt loaded — press Save to apply")

    def _do_save(self):
        cfg = self._collect()
        try:
            save_config(cfg)
        except OSError as exc:
            dialog = Adw.MessageDialog(
                transient_for=self,
                heading="Could not save settings",
                body=str(exc),
            )
            dialog.add_response("ok", "OK")
            dialog.present()
            return False
        self.cfg = cfg
        return True

    def _on_save(self, _btn):
        if self._do_save():
            self._toast("Settings saved")

    def _on_save_and_regen(self, btn):
        if not self._do_save():
            return
        btn.set_sensitive(False)
        self._toast("Saved — regenerating wallpaper in the background…")
        try:
            subprocess.Popen(
                [DYNWALL_CMD, "--animate", str(self.cfg["frames"])],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError as exc:
            self._toast(f"Could not launch dynwall: {exc}")
        GLib.timeout_add_seconds(5, lambda: (btn.set_sensitive(True), False)[1])


class DynwallSettingsApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_activate(self):
        win = self.get_active_window()
        if win is None:
            win = SettingsWindow(self)
        win.present()


def main():
    Adw.init()
    app = DynwallSettingsApp()
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
